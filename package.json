{
  "name": "agentic",
  "private": true,
  "type": "module",
  "workspaces": [
    "applications/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --concurrency 100",
    "fix": "turbo run lint:fix && eslint . --fix",
    "lint": "turbo run lint lint:root lint:manifests",
    "lint:manifests": "bun scripts/check-workspace-manifests.ts",
    "lint:root": "eslint . --cache",
    "test": "turbo run test test:root",
    "test:root": "bun test scripts",
    "typecheck": "turbo run typecheck",
    "verify": "turbo run lint lint:root lint:manifests typecheck test test:root"
  },
  "devDependencies": {
    "@agentic/tooling-eslint-config": "workspace:*",
    "eslint": "10.12.0",
    "turbo": "^2.11.10",
    "typescript": "6.0.3"
  },
  "packageManager": "bun@1.4.2"
}
