{
  "name": "@agentic/cli",
  "version": "0.1.0",
  "private": true,
  "description": "`agentic` CLI: a pure client of the local API (contract-http schemas), plus `serve` to start it.",
  "type": "module",
  "bin": {
    "agentic": "./src/main.ts"
  },
  "scripts": {
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix",
    "start": "bun --conditions development src/main.ts",
    "test": "bun test --conditions development src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentic/contract-http": "workspace:*",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@agentic/domain-shared": "workspace:*",
    "@agentic/kernel-result": "workspace:*",
    "@agentic/server": "workspace:*",
    "@agentic/tooling-eslint-config": "workspace:*",
    "@types/bun": "1.3.14",
    "eslint": "10.12.0",
    "typescript": "7.0.2"
  }
}
