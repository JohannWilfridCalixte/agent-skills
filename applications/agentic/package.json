{
  "name": "@agentic/agentic",
  "version": "0.1.0",
  "private": true,
  "description": "agentic web SPA: TanStack Start in SPA mode (no SSR, no server functions) over the local Hono API.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "generate:routes": "bun scripts/generate-route-tree.ts",
    "lint": "bun scripts/generate-route-tree.ts && eslint . --cache",
    "lint:fix": "bun scripts/generate-route-tree.ts && eslint . --fix",
    "preview": "vite preview",
    "test": "bun scripts/generate-route-tree.ts && vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "bun scripts/generate-route-tree.ts && tsc --noEmit"
  },
  "dependencies": {
    "@agentic/contract-http": "workspace:*",
    "@agentic/design-system": "workspace:*",
    "@agentic/kernel-result": "workspace:*",
    "@tanstack/react-query": "5.104.2",
    "@tanstack/react-router": "1.170.42",
    "@tanstack/react-start": "1.168.61",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@agentic/tooling-eslint-config": "workspace:*",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.3",
    "eslint": "10.12.0",
    "happy-dom": "21.0.4",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
